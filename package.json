{
  "name": "yaml-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run generate && npm run typecheck && vite-ssg build",
    "generate": "node scripts/content.mjs && npm run generate:glass",
    "generate:glass": "node scripts/prepare-reeded-glass.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "preview:cloudflare": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.17",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "markdown-it": "^15.0.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vite-ssg": "^28.3.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.135.0",
    "yaml": "^2.9.1"
  }
}
